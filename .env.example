# Copia este fichero a .env y rellena los valores. .env NUNCA va a Git.
# Para versionar los secretos cifrados: task secrets:init && task secrets:encrypt
# (genera secrets.enc.env con sops + age; ese sí se puede subir).

# ── AWS / Amazon Bedrock ────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
# Tu perfil de administración (o SSO). Solo lo usa Terraform para crear el usuario IAM
# mínimo del lab y el presupuesto; el lab en ejecución usa ese usuario mínimo, no tu perfil.
AWS_PROFILE=
# Perfiles de inferencia EU (los modelos solo se invocan mediante perfil de inferencia).
SUPERVISOR_MODEL_ID=eu.anthropic.claude-sonnet-5-5
SUBAGENT_MODEL_ID=eu.anthropic.claude-haiku-5-5
JUDGE_MODEL_ID=eu.anthropic.claude-haiku-5-5
# Opcional: presupuesto mensual (USD) y correo de la alarma de AWS Budgets.
#LAB_BUDGET_USD=25
#LAB_BUDGET_EMAIL=

# ── Arize AX ────────────────────────────────────────────────────────────────────
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=agentic-lab
# Opcional: región del tenant si no es la de EE. UU. (EU, CA) y su host OTLP.
#ARIZE_REGION=EU
#ARIZE_OTLP_HOST=otlp.eu-west-1a.arize.com
# Juez de las evals ONLINE (integración de IA de Bedrock en AX). Una de las dos:
#ARIZE_AI_INTEGRATION_ID=
#ARIZE_BEDROCK_ROLE_ARN=

# ── Dynatrace ───────────────────────────────────────────────────────────────────
# Sin barra final y sin ".apps.": https://<id-entorno>.live.dynatrace.com
DT_ENV_URL=https://<id-entorno>.live.dynatrace.com
# Token de ingesta OTLP (trazas, logs y métricas).
DT_INGEST_TOKEN=
# Bearer para token platform (dt0s16.*), Api-Token para access token (dt0c01.*).
DT_AUTH_SCHEME=Api-Token
# Platform token para Terraform (dashboard, alertas, OpenPipeline).
DT_CONFIG_TOKEN=
# Opcional: service user (UUID) con el que se ejecutan las consultas de las alertas.
#DT_ALERT_ACTOR=

# ── Bindplane (self-hosted, dentro del compose) ─────────────────────────────────
BINDPLANE_LICENSE=
BINDPLANE_ADMIN_USER=admin
BINDPLANE_ADMIN_PASSWORD=
# Imagen del colector. Por defecto, la imagen pública de DBDOT (Dynatrace Bindplane
# Distribution of OpenTelemetry Collector). Cámbiala si usáis un registro interno.
DBDOT_IMAGE=ghcr.io/dynatrace/dynatrace-bindplane-otel-collector:1.4.2
